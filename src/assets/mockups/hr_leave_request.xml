  <transition>
    <id>hr_review</id>
    <x>560</x>
    <y>208</y>
    <label>HR Review</label>
    <icon>how_to_reg</icon>
    <priority>1</priority>
    <roleRef>
      <id>hr</id>
      <logic>
        <perform>true</perform>
      </logic>
    </roleRef>
    <dataGroup>
      <id>dg_hr</id>
      <cols>2</cols>
      <layout>grid</layout>
      <title>HR Review</title>
      <dataRef>
        <id>leave_type</id>
        <logic>
          <behavior>visible</behavior>
        </logic>
        <layout>
          <x>0</x>
          <y>0</y>
          <rows>1</rows>
          <cols>1</cols>
          <template>material</template>
          <appearance>outline</appearance>
        </layout>
      </dataRef>
      <dataRef>
        <id>start_date</id>
        <logic>
          <behavior>visible</behavior>
        </logic>
        <layout>
          <x>0</x>
          <y>1</y>
          <rows>1</rows>
          <cols>1</cols>
          <template>material</template>
          <appearance>outline</appearance>
        </layout>
      </dataRef>
      <dataRef>
        <id>end_date</id>
        <logic>
          <behavior>visible</behavior>
        </logic>
        <layout>
          <x>1</x>
          <y>1</y>
          <rows>1</rows>
          <cols>1</cols>
          <template>material</template>
          <appearance>outline</appearance>
        </layout>
      </dataRef>
      <dataRef>
        <id>reason</id>
        <logic>
          <behavior>visible</behavior>
        </logic>
        <layout>
          <x>0</x>
          <y>2</y>
          <rows>1</rows>
          <cols>2</cols>
          <template>material</template>
          <appearance>outline</appearance>
        </layout>
      </dataRef>
      <dataRef>
        <id>attachment</id>
        <logic>
          <behavior>visible</behavior>
        </logic>
        <layout>
          <x>0</x>
          <y>3</y>
          <rows>1</rows>
          <cols>2</cols>
          <template>material</template>
          <appearance>outline</appearance>
        </layout>
      </dataRef>
      <dataRef>
        <id>manager_comment</id>
        <logic>
          <behavior>visible</behavior>
        </logic>
        <layout>
          <x>0</x>
          <y>4</y>
          <rows>1</rows>
          <cols>2</cols>
          <template>material</template>
          <appearance>outline</appearance>
        </layout>
      </dataRef>
      <dataRef>
        <id>hr_comment</id>
        <logic>
          <behavior>editable</behavior>
          <behavior>required</behavior>
        </logic>
        <layout>
          <x>0</x>
          <y>5</y>
          <rows>1</rows>
          <cols>2</cols>
          <template>material</template>
          <appearance>outline</appearance>
        </layout>
      </dataRef>
    </dataGroup>
    <event type="finish">
      <id>hr_finish</id>
      <actions phase="pre">
        <action id="5">
<![CDATA[
            go_hr_approve: f.go_hr_approve, go_hr_reject: f.go_hr_reject, status: f.status;
            decision = (hr_comment.value?.toLowerCase()?.contains("reject")) ? "reject" : "approve"
            if (decision == "approve") {
            change go_hr_approve value { 1 }
            change go_hr_reject value { 0 }
            change status value { "Approved by HR" }
            } else {
            change go_hr_approve value { 0 }
            change go_hr_reject value { 1 }
            change status value { "Rejected by HR" }
            }
            ]]>
        </action>
      </actions>
      <actions phase="post">
        <action id="6">
<![CDATA[
            go_hr_reject: f.go_hr_reject, employee_email: f.employee_email, hr_comment: f.hr_comment;
            if ((go_hr_reject.value as Integer) == 1 && employee_email.value) {
            sendEmail([employee_email.value], "Leave Request Rejected by HR", "Your leave request was rejected by HR. Comment: ${hr_comment.value}")
            }
            ]]>
        </action>
      </actions>
    </event>
