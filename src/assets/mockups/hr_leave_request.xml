        </logic>
        <layout>
          <x>0</x>
          <y>3</y>
          <rows>1</rows>
          <cols>2</cols>
          <template>material</template>
          <appearance>outline</appearance>
        </layout>
      </dataRef>
      <dataRef>
        <id>manager_comment</id>
        <logic>
          <behavior>editable</behavior>
          <behavior>required</behavior>
        </logic>
        <layout>
          <x>0</x>
          <y>4</y>
          <rows>1</rows>
          <cols>2</cols>
          <template>material</template>
          <appearance>outline</appearance>
        </layout>
      </dataRef>
    </dataGroup>
    <event type="finish">
      <id>manager_finish</id>
      <actions phase="pre">
        <action id="3">
<![CDATA[
            go_manager_approve: f.go_manager_approve, go_manager_reject: f.go_manager_reject, status: f.status;
            decision = (manager_comment.value?.toLowerCase()?.contains("reject")) ? "reject" : "approve"
            if (decision == "approve") {
            change go_manager_approve value { 1 }
            change go_manager_reject value { 0 }
            change status value { "Pending HR Approval" }
            } else {
            change go_manager_approve value { 0 }
            change go_manager_reject value { 1 }
            change status value { "Rejected by Manager" }
            }
            ]]>
        </action>
      </actions>
      <actions phase="post">
        <action id="4">
<![CDATA[
            go_manager_reject: f.go_manager_reject, employee_email: f.employee_email, manager_comment: f.manager_comment;
            if ((go_manager_reject.value as Integer) == 1 && employee_email.value) {
            sendEmail([employee_email.value], "Leave Request Rejected by Manager", "Your leave request was rejected by your manager. Comment: ${manager_comment.value}")
            }
            ]]>
        </action>
      </actions>
    </event>
